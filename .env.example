# ── Service ports ────────────────────────────────────────────────────────────
SSH_PORT=2222
HTTP_PORT=8888
FTP_PORT=21
TELNET_PORT=23
DASHBOARD_PORT=5000

# ── Dashboard basic-auth (leave both empty to disable) ───────────────────────
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme

# ── Webhook alerts (leave empty to disable) ──────────────────────────────────
# One credential-capture alert per IP per 60 seconds
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_FILE=data/honeypot.log

# ── Banners (change to mimic a different target) ─────────────────────────────
SSH_BANNER=SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.6
HTTP_SERVER_HEADER=Apache/2.4.41 (Ubuntu)
